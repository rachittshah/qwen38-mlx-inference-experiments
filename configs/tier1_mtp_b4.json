{
  "name": "tier1_mtp_b4",
  "tier": 1,
  "description": "MTP speculative decoding, draft-block-size 4 (current default). Decode-speed + acceptance.",
  "server": {
    "port": 8081,
    "host": "127.0.0.1",
    "use_draft": true,
    "draft_kind": "mtp",
    "flags": ["--max-num-seqs", "1", "--draft-block-size", "4"],
    "env": {},
    "startup_timeout": 180
  },
  "workload": { "type": "short", "turns": 2, "max_tokens": 200 }
}
