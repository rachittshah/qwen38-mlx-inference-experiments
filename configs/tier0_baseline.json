{
  "name": "tier0_baseline",
  "tier": 0,
  "description": "Baseline: APC OFF, default wired limit. MTP drafter, block 4, single seq. Growing 15K-prefix conversation.",
  "server": {
    "port": 8081,
    "host": "127.0.0.1",
